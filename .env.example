# Copy this file to .env and replace placeholders locally. Never commit .env.
FLASK_APP=run.py
FLASK_DEBUG=false
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value

MONGODB_URI=mongodb+srv://<db_username>:<url_encoded_password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=cyberbullying_analytics

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=generate-a-fernet-key

# Local development only. Set true behind HTTPS in deployment.
SESSION_COOKIE_SECURE=false